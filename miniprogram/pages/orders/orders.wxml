<!-- 订单列表页 -->
<view class="orders-page">
  <segmented-tabs tabs="{{tabs}}" value="{{activeTabValue}}" bind:change="onTabChange" />
  
  <!-- 订单列表 -->
  <scroll-view 
    class="order-list" 
    scroll-y="{{true}}"
    scroll-top="{{scrollTop}}"
    enable-back-to-top="{{true}}"
    bindscroll="onScroll"
    bindscrolltolower="onLoadMore"
    refresher-enabled="{{true}}"
    refresher-triggered="{{isRefreshing}}"
    refresher-default-style="black"
    refresher-background="#f5f5f5"
    bindrefresherrefresh="onRefresh"
  >
    <view class="initial-loading" wx:if="{{isLoading && orders.length === 0}}">
      <loading type="spinner" text="加载中..." />
    </view>

    <!-- 订单卡片列表 -->
    <view class="list-content" wx:if="{{orders.length > 0}}">
      <order-card 
        wx:for="{{orders}}" 
        wx:key="id"
        order="{{item}}"
        bind:tap="onOrderTap"
        bind:action="onOrderAction"
      />
    </view>
    
    <!-- 加载状态 -->
    <view class="load-status">
      <loading wx:if="{{isLoading && orders.length > 0}}" type="spinner" text="加载中..."/>
      <text class="no-more" wx:if="{{!hasMore && orders.length > 0}}">没有更多了</text>
    </view>
    
    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{!isLoading && orders.length === 0}}">
      <text class="empty-icon">📋</text>
      <text class="empty-text">暂无{{tabs[currentTab].label}}订单</text>
      <button class="btn-go" bindtap="onGoBooking">去预约</button>
    </view>
  </scroll-view>
</view>
