<view class="bookings-page">
  <view class="mode-banner">{{mode === 'worker' ? '我的预约（阿姨端）' : '我的预约（雇主端）'}}</view>
  <segmented-tabs tabs="{{filterTabs}}" value="{{activeFilter}}" bind:change="onTabChange" />
  <scroll-view
    class="booking-list"
    scroll-y="{{true}}"
    bindscrolltolower="onLoadMore"
    refresher-enabled="{{true}}"
    refresher-triggered="{{isRefreshing}}"
    refresher-background="#f5f5f5"
    bindrefresherrefresh="onRefresh"
  >
    <view class="initial-loading" wx:if="{{isLoading && bookings.length === 0}}">
      <loading type="spinner" text="加载中..." />
    </view>

    <view class="list-content" wx:if="{{bookings.length > 0}}">
      <view class="booking-card" wx:for="{{bookings}}" wx:key="_id">
        <view class="header">
          <view class="worker">
            <image class="avatar" src="{{item.displayAvatar || '/images/default-avatar.png'}}" mode="aspectFill" />
            <view class="meta">
              <text class="name">{{item.displayName}}</text>
              <text class="time">提交于 {{item.createdAtText}}</text>
            </view>
          </view>
          <text class="status">{{item.statusText}}</text>
        </view>

        <view class="detail-row" wx:if="{{item.serviceType}}">
          <text class="label">服务类型</text>
          <text class="value">{{item.serviceTypeText}}</text>
        </view>
        <view class="detail-row" wx:if="{{item.startDate}}">
          <text class="label">开始时间</text>
          <text class="value">{{item.startDate}}</text>
        </view>
        <view class="detail-row" wx:if="{{item.duration}}">
          <text class="label">服务时长</text>
          <text class="value">{{item.duration}}</text>
        </view>
        <view class="detail-row" wx:if="{{item.address}}">
          <text class="label">服务地址</text>
          <text class="value address">{{item.address}}</text>
        </view>
        <view class="detail-row" wx:if="{{item.totalPrice}}">
          <text class="label">预算金额</text>
          <text class="value price">¥{{item.totalPrice}}</text>
        </view>
        <view class="detail-row" wx:if="{{item.rejectReason}}">
          <text class="label">拒绝原因</text>
          <text class="value">{{item.rejectReason}}</text>
        </view>
        <view class="detail-row" wx:if="{{item.interviewTime}}">
          <text class="label">面试时间</text>
          <text class="value">{{item.interviewTime}}</text>
        </view>

        <view class="actions" wx:if="{{item.canCancel || item.canTerminate || item.canSubmitOrder || item.canViewOrder || item.canWorkerAccept || item.canWorkerReject || item.canWorkerContact}}">
          <button class="btn-secondary" wx:if="{{item.canCancel}}" data-booking-id="{{item._id}}" bindtap="onCancelBooking">取消预约</button>
          <button class="btn-secondary" wx:if="{{item.canTerminate}}" data-booking-id="{{item._id}}" bindtap="onTerminateBooking">终止预约</button>
          <button class="btn-primary" wx:if="{{item.canSubmitOrder}}" data-booking-id="{{item._id}}" bindtap="onSubmitOrder">提交订单</button>
          <button class="btn-primary" wx:if="{{item.canViewOrder}}" data-order-id="{{item.orderId}}" bindtap="onViewOrder">查看订单</button>

          <button class="btn-secondary" wx:if="{{item.canWorkerReject}}" data-booking-id="{{item._id}}" bindtap="onWorkerReject">拒绝</button>
          <button class="btn-primary" wx:if="{{item.canWorkerAccept}}" data-booking-id="{{item._id}}" bindtap="onWorkerAccept">接受</button>
          <button class="btn-secondary" wx:if="{{item.canWorkerContact}}" data-phone="{{item.contactPhone}}" bindtap="onWorkerContact">联系雇主</button>
        </view>
      </view>
    </view>

    <view class="load-status">
      <loading wx:if="{{isLoading && bookings.length > 0}}" type="spinner" text="加载中..." />
      <text class="no-more" wx:if="{{!hasMore && bookings.length > 0}}">没有更多了</text>
    </view>

    <view class="empty-state" wx:if="{{!isLoading && bookings.length === 0}}">
      <text class="empty-icon">🗂️</text>
      <text class="empty-text">{{mode === 'worker' ? '暂无被预约记录' : '暂无预约记录'}}</text>
      <button class="btn-go" wx:if="{{mode !== 'worker'}}" bindtap="onGoWorkers">去预约</button>
    </view>
  </scroll-view>
</view>
