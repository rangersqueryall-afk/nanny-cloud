.admin-page {
  min-height: 100vh;
  background: #f5f5f5;
}

.top-nav {
  display: flex;
  background: #fff;
  padding: 14rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.top-item {
  margin-right: 12rpx;
  padding: 10rpx 16rpx;
  font-size: 24rpx;
  color: #666;
  border-radius: 22rpx;
  background: #f3f3f3;
}

.top-item.active {
  color: #fff;
  background: #ff6b6b;
}

.tab-nav {
  display: flex;
  background: #fff;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.tab-item {
  margin-right: 20rpx;
  padding: 10rpx 20rpx;
  font-size: 26rpx;
  color: #666;
  border-radius: 24rpx;
  background: #f3f3f3;
}

.tab-item.active {
  color: #fff;
  background: #ff6b6b;
}

.stats-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  padding: 18rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.stats-label {
  font-size: 26rpx;
  color: #666;
}

.stats-picker {
  font-size: 26rpx;
  color: #333;
  background: #f3f3f3;
  border-radius: 20rpx;
  padding: 8rpx 16rpx;
}

.list-wrap {
  height: calc(100vh - 176rpx);
}

.card-list {
  padding: 20rpx 24rpx;
}

.initial-loading {
  min-height: 320rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.name {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
}

.status {
  font-size: 22rpx;
  color: #ff6b6b;
  background: #fff1f1;
  padding: 4rpx 12rpx;
  border-radius: 18rpx;
}

.row {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #444;
  word-break: break-all;
}

.label {
  color: #999;
}

.actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 18rpx;
  gap: 12rpx;
  flex-wrap: wrap;
}

.btn-primary,
.btn-danger,
.btn-secondary {
  margin: 0;
  min-width: 146rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  color: #fff;
  padding: 0 16rpx;
}

.btn-primary {
  background: #ff6b6b;
}

.btn-danger {
  background: #999;
}

.btn-secondary {
  background: #55606f;
}

.btn-primary::after,
.btn-danger::after,
.btn-secondary::after {
  border: none;
}

.stats-wrap {
  padding: 20rpx 24rpx 40rpx;
}

.stats-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.stats-title {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 18rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.stats-item {
  background: #f8f9fb;
  border-radius: 12rpx;
  padding: 16rpx;
}

.stats-item .n {
  display: block;
  font-size: 34rpx;
  color: #ff6b6b;
  font-weight: 700;
}

.stats-item .k {
  display: block;
  font-size: 22rpx;
  color: #666;
  margin-top: 6rpx;
}

.stats-row {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #444;
}

.load-status {
  text-align: center;
  padding: 20rpx;
}

.no-more {
  font-size: 24rpx;
  color: #999;
}

.empty {
  text-align: center;
  padding: 200rpx 0;
  color: #999;
  font-size: 28rpx;
}
